{
  "name": "ide-client",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Language Server Protocol client infrastructure.",
  "keywords": [
    "lsp",
    "language-server",
    "intellisense",
    "diagnostics",
    "completion"
  ],
  "repository": "https://github.com/lumine-code/ide-client",
  "bugs": {
    "url": "https://github.com/lumine-code/ide-client/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "spec",
    "styles"
  ],
  "types": "./lib/main.d.ts",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "backgroundTips": [
    "{% if keys['ide-client:servers'] %}You can see every language server that is running, and restart any of them, with {{ 'ide-client:servers' | keystroke }}{% else %}Lumine speaks the Language Server Protocol. Install an ide package for your language to get completions, diagnostics, and go-to-definition.{% endif %}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "trace": {
      "title": "Protocol Trace",
      "description": "Log the traffic between the editor and language servers to the per-server log buffer.",
      "type": "string",
      "enum": [
        "off",
        "messages",
        "verbose"
      ],
      "default": "off"
    },
    "restartLimit": {
      "title": "Maximum Automatic Restarts",
      "description": "How many times in a row a crashed language server is restarted automatically before giving up. A server that stays up for a minute gets its restarts back.",
      "type": "integer",
      "minimum": 0,
      "default": 3
    },
    "statusBar": {
      "title": "Status Bar",
      "description": "Indicator for the language servers this window is running.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "description": "Show the running language servers in the status bar. The item stays in place while none is running, reporting zero.",
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "providedServices": {
    "ide-client": {
      "versions": {
        "1.0.0": "provideIdeClient"
      }
    },
    "autocomplete.provider": {
      "versions": {
        "1.0.0": "provideAutocomplete"
      }
    },
    "symbol.provider": {
      "versions": {
        "1.0.0": "provideSymbol"
      }
    },
    "hover.provider": {
      "versions": {
        "1.0.0": "provideHover"
      }
    },
    "hover.signature-provider": {
      "versions": {
        "1.0.0": "provideHoverSignature"
      }
    },
    "outline.provider": {
      "versions": {
        "1.0.0": "provideOutline"
      }
    },
    "code-format.range": {
      "versions": {
        "1.0.0": "provideCodeFormatRange"
      }
    },
    "code-format.file": {
      "versions": {
        "1.0.0": "provideCodeFormatFile"
      }
    },
    "code-format.on-type": {
      "versions": {
        "1.0.0": "provideCodeFormatOnType"
      }
    },
    "code-format.on-save": {
      "versions": {
        "1.0.0": "provideCodeFormatOnSave"
      }
    },
    "find-references.provider": {
      "versions": {
        "1.0.0": "provideFindReferences"
      }
    },
    "refactor.provider": {
      "versions": {
        "1.0.0": "provideRefactor"
      }
    },
    "intentions.list": {
      "versions": {
        "1.0.0": "provideIntentionsList"
      }
    },
    "code-lens.provider": {
      "versions": {
        "1.0.0": "provideCodeLens"
      }
    },
    "inlay-hints.provider": {
      "versions": {
        "1.0.0": "provideInlayHints"
      }
    },
    "semantic-tokens.provider": {
      "versions": {
        "1.0.0": "provideSemanticTokens"
      }
    }
  },
  "consumedServices": {
    "linter.registry": {
      "versions": {
        "^1.0.0": "consumeLinterRegistry"
      }
    },
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "tar": "^7.5.22",
    "vscode-jsonrpc": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
